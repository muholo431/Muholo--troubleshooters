name: Build Muholo Troubleshooter APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: gradle/actions/setup-gradle@v4

      - name: Build APK
        run: |
          cd MuholoTroubleshooter
          gradle assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: Muholo-Troubleshooter-APK
          path: MuholoTroubleshooter/app/build/outputs/apk/debug/*.apk
